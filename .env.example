# ---------------------------------------------------------------------------
# INFINITE GYM CENTER - environment template
# Copy to .env.local and replace placeholders. NEVER commit real credentials.
# All values below are non-functional placeholders for local development.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters
DEMO_MODE=true
NEXT_PUBLIC_DEMO_DATA=true

# Supabase (PostgreSQL, Auth, Storage, Row Level Security)
# Required only when switching the app from the local demo store to Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Stripe TEST MODE only. Use sk_test_ / pk_test_ keys. No real charges.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2024-06-20

# Email notifications (configurable provider). Leave blank to queue demo
# notifications without sending. SMS and push are future integrations.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM="INFINITE GYM CENTER <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Feature flags
NEXT_PUBLIC_ENABLE_STRIPE_CHECKOUT=false
NEXT_PUBLIC_ENABLE_EMAIL=false
